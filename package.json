{
  "name": "family-car-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm install --prefix frontend && pip install -r backend/requirements.txt",
    "dev:backend": "python -m uvicorn main:app --port 5000 --reload --app-dir backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "start": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
